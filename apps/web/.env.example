# Room and token issuance (all keys below are server-only except the public URL).
# Configure the server host used to build invite links.
NASTYA_PUBLIC_ORIGIN=http://localhost:3000

# Secure LiveKit URL (use ws://localhost:7880 for local development).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Optional comma-separated exact HTTPS/WSS origins for LiveKit regional routing.
# CSP permits LIVEKIT_URL and its HTTPS equivalent automatically. Set at build time.
# No wildcards, paths, credentials or general scheme sources are accepted.
NASTYA_LIVEKIT_CONNECT_ORIGINS=

# Dedicated HMAC signing key for role-specific invite links; minimum 32 bytes.
# Generate using: openssl rand -hex 32
NASTYA_INVITE_SECRET=replace-with-at-least-32-random-bytes

# REQUIRED in production and every public/non-loopback deployment. Use a dedicated Redis REST
# instance with atomic Lua EVAL enabled; not visible to the browser or CDN.
# Room creation and role redemptions fail closed if these are absent/unreachable.
NASTYA_REDIS_REST_URL=https://your-redis-instance.upstash.io
NASTYA_REDIS_REST_TOKEN=replace-with-redis-rest-token

# Only non-production HTTP loopback uses process-local fallback.
# Deploy HTTPS with a real public origin (not loopback behind a public proxy).
