# Room and token issuance (all keys below are server-only except the public URL).
# Configure the server host used to build invite links.
NASTYA_PUBLIC_ORIGIN=http://localhost:3000

# Secure LiveKit URL (use ws://localhost:7880 for local development).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Dedicated HMAC signing key for role-specific invite links; minimum 32 bytes.
# Generate using: openssl rand -hex 32
NASTYA_INVITE_SECRET=replace-with-at-least-32-random-bytes
