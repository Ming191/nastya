# These URLs will point to your future model server; no Kaggle is required.
# Use HTTPS for internet-facing model APIs. HTTP is allowed only for loopback development.
NASTYA_STT_URL=https://models.example.com/v1/audio/transcriptions
NASTYA_MT_URL=https://models.example.com/v1/translate

# Optional Bearer tokens, different per service if needed (never commit real values).
NASTYA_STT_API_KEY=replace-me
NASTYA_MT_API_KEY=replace-me

# STT endpoint uses OpenAI-style multipart fields: file, model, language.
NASTYA_STT_MODEL=whisper-1
# MT endpoint uses JSON fields: text, source_language, target_language, optional model.
NASTYA_MT_MODEL=nllb
NASTYA_HTTP_TIMEOUT_SECONDS=20
NASTYA_LOG_LEVEL=INFO

# LiveKit media ingestion (only when starting worker with --room)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
# Only share the room ID, never guest/owner invite bearer tokens.
# Run: python -m nastya_worker --room nastya_<32-hex-room-id>

# Optional experimental TTS. OFF by default, never sent through browser.
NASTYA_TTS_ENABLED=false
NASTYA_TTS_PROVIDER=edge
NASTYA_TTS_TIMEOUT_SECONDS=8
